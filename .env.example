# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=1

# Database (SQLite for local dev; swap for a Postgres URL in production)
DATABASE_URL=sqlite:///app.db

# LLM provider
# "gemini" is the only fully-wired provider right now (real free tier,
# supports both text chat and multimodal image analysis).
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-1.5-flash

# Max upload size for crop photos, in megabytes
MAX_UPLOAD_MB=5
